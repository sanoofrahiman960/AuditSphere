# Copy to backend/.env and adjust. Never commit the real .env.

# --- Django ---------------------------------------------------------------
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
TIME_ZONE=UTC
# Only behind a reverse proxy that sets X-Forwarded-For itself
TRUST_X_FORWARDED_FOR=false

# --- Database ---------------------------------------------------------------
# Empty = local SQLite file backend/db.sqlite3 (zero setup for local development).
# PostgreSQL:
# DATABASE_URL=postgres://auditsphere:change-me@localhost:5432/auditsphere
DATABASE_URL=
DATABASE_CONN_MAX_AGE=60

# --- Frontend / CORS -----------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth -------------------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
THROTTLE_LOGIN=10/min

# --- Files -------------------------------------------------------------------------
# local = private folder (MEDIA_ROOT) streamed via authorised API endpoints; s3 = S3 / compatible
STORAGE_BACKEND=local
MEDIA_ROOT=
MAX_UPLOAD_SIZE_MB=20
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=          # for MinIO / other S3-compatible stores
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Email ------------------------------------------------------------------------------
# Console backend prints emails to the server log (development).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=AuditSphere <no-reply@auditsphere.local>
# Optional: deliver notification emails through an n8n webhook instead of SMTP
N8N_WEBHOOK_URL=

# --- Background jobs -----------------------------------------------------------------------
# Empty broker = tasks run in-process (no Redis needed). Use `manage.py run_reminders` daily.
CELERY_BROKER_URL=
# CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=
REMINDER_HOUR=7

# --- Logging / monitoring -------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=plain
SENTRY_DSN=

# --- AI module (optional; pip install -r requirements-optional.txt) ---------------------------
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Embedding provider (Voyage-style API: POST {input, model, input_type} -> {data:[{embedding}]})
EMBEDDING_API_URL=https://api.voyageai.com/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIMENSIONS=1024
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=auditsphere_policies

# --- Development seed ----------------------------------------------------------------------------
SEED_DEMO_PASSWORD=AuditSphere#2026
