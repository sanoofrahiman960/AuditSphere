# Copy to .env (next to docker-compose.yml) for `docker compose`.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_DB=auditsphere
POSTGRES_USER=auditsphere
POSTGRES_PASSWORD=change-me
HTTP_PORT=8080
FRONTEND_URL=http://localhost:8080
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Set to true once TLS is terminated in front of the stack
SECURE_SSL_REDIRECT=false
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AuditSphere <no-reply@example.com>
SENTRY_DSN=
INSTALL_OPTIONAL=false
AI_ENABLED=false
ANTHROPIC_API_KEY=
